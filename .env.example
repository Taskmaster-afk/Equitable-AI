# GEMINI_API_KEY: Required for live Gemini AI API calls (offline fallback used if empty).
GEMINI_API_KEY=""

# MONGODB_URI: MongoDB connection string for persistent database backend.
# Examples:
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/equitable_ai?retryWrites=true&w=majority
# Local MongoDB: mongodb://localhost:27017/equitable_ai
MONGODB_URI=""

# SESSION_SECRET: Secret for signing JWT/session tokens.
SESSION_SECRET="equitable-ai-open-curriculum-secret-2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

